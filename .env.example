# ─────────────────────────────────────────────────────────────────────────────
# LICENSEVAULT — ENVIRONMENT EXAMPLE
#
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# NEVER commit `.env.local` or any file containing a real private key.
# NEVER prefix a private key with NEXT_PUBLIC_ — that ships it to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (safe for the browser) ────────────────────────────────────────────

# Story Aeneid testnet chain ID. Verified live 2026-10-05 (eth_chainId → 0x523).
NEXT_PUBLIC_STORY_CHAIN_ID=1315

# Story Aeneid EVM RPC. Verified live 2026-10-05.
NEXT_PUBLIC_STORY_RPC_URL=https://aeneid.storyrpc.io

# Block explorer for Aeneid — used ONLY to build links for transactions that
# actually exist. Verified 2026-10-05: its block height matched the Aeneid RPC at
# the same moment, and GET /tx/<hash> served a real transaction. The older
# aeneid.storyscan.io host is NXDOMAIN — do not restore it.
NEXT_PUBLIC_STORY_EXPLORER_URL=https://aeneid.datanetscan.io

# ── Reference only — not read by the app ─────────────────────────────────────
# Aeneid testnet faucet. CORRECTED 2026-10-07 — the previously recorded route
# (faucet.quicknode.com/story) is reachable but gated on holding ETH on MAINNET,
# so it is unusable from a standing start. This is the route the first-party docs
# name, with a documented amount of 10 IP:
#   https://aeneid.faucet.datafdn.org/
# (source: https://docs.datafdn.org/network/connect/aeneid.md)
# Funding is a MANUAL human step: this project never automates a claim and never
# asks for a seed phrase. The faucet itself sits behind a Cloudflare bot
# challenge, so its contents are documented, not observed by us.
# AENEID_FAUCET_URL=https://aeneid.faucet.datafdn.org/

# ── Server-only (never exposed to the browser) ───────────────────────────────

# CDR Story-API REST base URL used by the CDR SDK for DKG/partial queries.
# NOTE: the currently documented value is plain HTTP on a raw IP
# (http://172.192.41.96:1317) and the docs say it "may change between deployments".
# It is deliberately an environment variable so it can be repointed at a self-hosted
# node without a code change. See docs/SECURITY.md §5 for the trust analysis:
# reads over it are integrity-protected by AEAD, so the exposure is availability.
# A failure here is INFRASTRUCTURE_FAILURE — never "no license".
CDR_API_URL=http://172.192.41.96:1317

# Server-side signer for the CDR flow. DISPOSABLE TESTNET KEY ONLY.
# Never a valuable wallet. Never Mainnet funds. Never committed.
# The UI must never be able to read this value.
CDR_SERVER_PRIVATE_KEY=

# ── BUILD 2 spike harness only (`npm run spike:vault`) ───────────────────────
# The harness that proves the real lock/unlock submits real transactions, so it
# needs real (disposable, testnet-only) keys. Read ONLY by tools/spike/*. These
# are NOT NEXT_PUBLIC_ and must never become NEXT_PUBLIC_.
#
# Owner wallet: creates the IP asset, allocates the vault, mints the license.
# Fund it at https://aeneid.faucet.datafdn.org/ — funding is a manual human step.
AENEID_PRIVATE_KEY=

# Reader wallet: the wallet that is refused a read before the mint and allowed
# after it. STRONGLY RECOMMENDED to be a DIFFERENT address from the owner.
# With one key the denial is still real (the owner holds no license yet) but
# weaker, and the harness says so in its output and in the evidence.
AENEID_READER_PRIVATE_KEY=

# Override the RPC / CDR API used by the harness. Optional; both default to the
# verified Aeneid values above.
# STORY_RPC_URL=https://aeneid.storyrpc.io

# Names the evidence directory. Optional; defaults to licensevault-aeneid-001.
# LICENSEVAULT_RUN_ID=licensevault-aeneid-001

# ── Verified Aeneid protocol addresses (public constants, safe to commit) ─────
# These are recorded here for transparency; they are verified facts, not secrets.

# DKG contract (eth_getCode → deployed, ERC1967 proxy)
NEXT_PUBLIC_CDR_DKG_ADDRESS=0xCcCcCC0000000000000000000000000000000004
# CDR contract (eth_getCode → deployed, ERC1967 proxy).
# NOTE the casing: the official docs print 0xCcCcCC…05, which is an INVALID EIP-55
# checksum (viem rejects it). The address bytes are identical; this is the
# computed-correct casing. See docs/PROTOCOL_DISCOVERY.md §3.
NEXT_PUBLIC_CDR_ADDRESS=0xCCCcCC0000000000000000000000000000000005
# Read condition: only Story Protocol license token holders for the IP can read
NEXT_PUBLIC_LICENSE_READ_CONDITION_ADDRESS=0xC0640AD4CF2CaA9914C8e5C44234359a9102f7a3
# Write condition: only the encoded address can write
NEXT_PUBLIC_OWNER_WRITE_CONDITION_ADDRESS=0x4C9bFC96d7092b590D497A191826C3dA2277c34B
# Story LicenseToken contract on Aeneid
NEXT_PUBLIC_LICENSE_TOKEN_ADDRESS=0xFe3838BFb30B34170F00030B52eA4893d8aAC6bC
